# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Virtual environments ────────────────────────────────
.venv/
env/
venv/
ENV/
backend/venv/
backend/venv_new/
backend/.venv/

# ─── Databases (DB ships seeded; don't track local changes) ─
*.db
*.sqlite3

# ─── Secrets / environment ───────────────────────────────
.env
backend/.env
*.env.local

# ─── Node / frontend ─────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
*.local

# ─── ML artifacts ────────────────────────────────────────
# NOTE: trained models (*.pkl), feature_names.json, fraud_threshold.json and
# *_report.txt are intentionally COMMITTED so the project runs out-of-the-box
# and the evaluation reports are available as evidence. Regenerate them with
# `python -m ml.train_fraud_model` / `python -m ml.train_recommendation_model`.

# ─── Logs & runtime-generated data ───────────────────────
*.log
backend/data/*_log.json
backend/uploads/

# ─── Temp / scratch ──────────────────────────────────────
_tmp_*.py
scratch/
backend/scratch/

# ─── IDEs / OS ───────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ─── Misc ────────────────────────────────────────────────
*.pdf
ScholarIQApp/
