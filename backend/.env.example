# ─── ScholarIQ Backend Environment ───────────────────────────
# Copy this file to `.env` and fill in real values.

# ── Required ──────────────────────────────────────────────────
# JWT signing secret (use a long random string)
SECRET_KEY=change-me-to-a-long-random-secret

# Admin dashboard credentials (env-based admin auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Optional: AI features ─────────────────────────────────────
# Chatbot, SOP writer, and the scholarship auto-update bot
OPENAI_API_KEY=
# Google Search for the auto-update bot
SERPER_API_KEY=

# ── Optional: database (defaults to local SQLite) ─────────────
# DATABASE_URL=sqlite:///./scholariq.db

# ── Optional: CORS origins (comma-separated) ──────────────────
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Optional: email (deadline notifications via fastapi-mail) ─
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_SERVER=
# MAIL_PORT=587
